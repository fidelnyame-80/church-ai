# Google Sheets spreadsheet shared with the service account
GOOGLE_SHEET_ID=

# Choose one service-account credential method:
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Or set GOOGLE_APPLICATION_CREDENTIALS to an absolute path to the JSON key file.
# GOOGLE_APPLICATION_CREDENTIALS=
# Or provide the complete service account JSON as one environment value.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Text chat provider: groq, nvidia, or xai. No fallback after an API error.
# If omitted, a configured Groq key wins, then NVIDIA, then xAI.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_SPEECH_MODEL=canopylabs/orpheus-v1-english
GROQ_SPEECH_VOICE=hannah

# Optional NVIDIA text provider.
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b

# Optional alternative text provider.
XAI_API_KEY=
XAI_MODEL=grok-4.7
