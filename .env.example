# Google Sheets spreadsheet shared with the service account
GOOGLE_SHEET_ID=

# Choose one service-account credential method:
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Or set GOOGLE_APPLICATION_CREDENTIALS to an absolute path to the JSON key file.
# GOOGLE_APPLICATION_CREDENTIALS=
# Or provide the complete service account JSON as one environment value.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Required to unlock the additional spreadsheet connector in Settings.
# Use a unique password of at least 12 characters; configure the same variable in Vercel.
# CHURCH_AI_ADMIN_PASSWORD=

# Groq is the default text and voice provider. Alternatives require AI_PROVIDER.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_SPEECH_MODEL=canopylabs/orpheus-v1-english
GROQ_SPEECH_VOICE=hannah

# Optional NVIDIA text provider.
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b

# Optional alternative text provider.
XAI_API_KEY=
XAI_MODEL=grok-4.7
